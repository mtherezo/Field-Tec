{
  "expo": {
    "name": "Field-Tec",
    "slug": "Field-Tec",
    "version": "2.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldtec",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "package": "com.mthz68.fieldtec"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mthz68.FieldTec"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "745cce2e-29d1-415f-bca6-608b83bd5f99"
      }
    }
  }
}
